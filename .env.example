# The RankUno Brief: settings from the environment. Copy to .env for local use; on Railway, add the same
# names under the service's Variables tab. Never commit .env.
#
# There are two mail profiles:
#   production  the real issue, to the production recipients, on the Monday/Thursday schedule
#   test        a [TEST] copy, sent whenever you ask, to TEST_RECIPIENTS only
#
# Any mail setting can be given per profile with a PROD_ or TEST_ prefix (PROD_MAIL_FROM, TEST_SMTP_PASSWORD, ...).
# The same name without a prefix is shared by both profiles, so only the differences need a prefix.
# Recipients are never shared between profiles.

# ---- Recipients and the production safety switch ----------------------------------------------------

# Test copies go to these addresses and nobody else (comma-separated).
TEST_RECIPIENTS=rajat.singh@rankuno.com

# Production issues are only sent when this is true. Leave false until the real list is ready.
PROD_SEND_ENABLED=false

# Optional production list (comma-separated). Empty = config/recipients.txt.
PROD_RECIPIENTS=

# ---- Mail settings shared by both profiles -------------------------------------------------------------

# smtp  = any SMTP server, e.g. Gmail with an App Password. Railway blocks SMTP on its Free and Hobby plans.
# graph = Microsoft 365 through Microsoft Graph (HTTPS; works on every Railway plan).
MAIL_PROVIDER=smtp
MAIL_FROM=rankuno@gmail.com
MAIL_FROM_NAME=The RankUno Brief
MAIL_REPLY_TO=

# For MAIL_PROVIDER=smtp. Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# For MAIL_PROVIDER=graph. From an Entra ID app registration with the Mail.Send application permission
# (admin consent). MAIL_FROM must then be an existing Microsoft 365 mailbox, e.g. brief@rankuno.com.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ---- Examples of per-profile overrides ----------------------------------------------------------------
# Production through Microsoft 365, tests through Gmail:
#   PROD_MAIL_PROVIDER=graph
#   PROD_MAIL_FROM=brief@rankuno.com
#   TEST_MAIL_PROVIDER=smtp

# ---- Hosting (python -m rankuno_brief serve) -------------------------------------------------------------

# Password for the admin page: at least 32 random characters. Empty = admin page off.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Where the database, built issues and logs live. On Railway: the volume's mount path, /data.
# Empty = the project's data/ folder.
DATA_DIR=
